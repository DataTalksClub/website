            "maxLength": 120,
            "type": "string"
          },
          "prefix": {
            "maxLength": 16,
            "minLength": 16,
            "type": "string"
          },
          "principal_id": {
            "format": "uuid",
            "type": "string"
          },
          "principal_label": {
            "maxLength": 120,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          },
          "state": {
            "enum": [
              "active",
              "expired",
              "revoked",
              "rotated"
            ],
            "type": "string"
          },
          "token": {
            "description": "One-time response value; never recoverable.",
