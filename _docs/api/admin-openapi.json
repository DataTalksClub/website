            "$ref": "#/components/schemas/CredentialMetadata"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "AdminHealth": {
        "additionalProperties": false,
        "properties": {
          "image_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "const": "ok",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "source_sha",
          "image_digest"
        ],
        "type": "object"
      },
      "CredentialCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "const": true,
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "target_principal_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "target_principal_id",
          "name",
          "scopes",
          "confirmed"
        ],
        "type": "object"
      },
      "CredentialList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CredentialMetadata"
            },
            "type": "array"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
