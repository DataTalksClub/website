        "summary": "View management health and the private Studio workspace shell",
        "x-audit-action": "studio.home.viewed",
        "x-capability-key": "studio.home.read",
        "x-concurrency": "none",
        "x-django-permission": "core.access_studio",
        "x-idempotency": "none",
        "x-rate-class": "read",
