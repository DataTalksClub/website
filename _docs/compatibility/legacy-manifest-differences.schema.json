{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datatalks.club/schemas/legacy-manifest-differences.schema.json",
  "title": "Legacy manifest differences",
  "type": "object",
  "additionalProperties": false,
  "required": ["differences", "record_kind", "schema_version"],
  "properties": {
    "record_kind": {
      "const": "legacy_manifest_differences"
    },
    "schema_version": {
      "const": 1
    },
    "differences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/difference"
      }
    }
  },
  "$defs": {
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "before",
        "difference_id",
        "field",
        "kind",
        "public_url",
        "required_action",
        "schema_version",
        "subject"
      ],
      "properties": {
        "after": true,
        "before": true,
        "difference_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "asset_added",
            "asset_removed",
            "canonical_changed",
            "field_changed",
            "fragment_added",
            "fragment_removed",
            "route_added",
            "route_removed"
          ]
        },
        "public_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "required_action": {
          "enum": [
            "restore_or_approve_asset",
            "restore_or_approve_canonical",
            "restore_or_approve_fragment",
            "restore_or_classify_route",
            "review_and_baseline_asset",
            "review_and_baseline_fragment",
            "review_and_baseline_route",
            "review_field_change"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
