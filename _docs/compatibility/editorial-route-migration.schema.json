{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datatalks.club/schemas/editorial-route-migration-v1.json",
  "title": "DataTalks.Club exhaustive editorial route migration manifest",
  "description": "Generated, digest-bound inventory of every clean editorial final and every approved one-hop legacy alias.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "provenance",
    "counts",
    "finals",
    "aliases",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "_docs/compatibility/editorial-route-migration.schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder",
        "projection_schema_version",
        "projection_selection_mode",
        "source_artifacts",
        "source_revisions"
      ],
      "properties": {
        "builder": { "const": "scripts/build_public_projection.py" },
        "projection_schema_version": { "const": 1 },
        "projection_selection_mode": { "enum": ["preferred", "fallback"] },
        "source_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["articles.json", "podcasts.json", "books.json", "people.json"],
          "properties": {
            "articles.json": { "$ref": "#/$defs/sha256" },
            "podcasts.json": { "$ref": "#/$defs/sha256" },
            "books.json": { "$ref": "#/$defs/sha256" },
            "people.json": { "$ref": "#/$defs/sha256" }
          }
        },
        "source_revisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "revision"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finals", "aliases"],
      "properties": {
        "finals": { "const": 796 },
        "aliases": { "const": 1592 }
      }
    },
    "finals": {
      "type": "array",
      "minItems": 796,
      "maxItems": 796,
      "items": { "$ref": "#/$defs/final" }
    },
    "aliases": {
      "type": "array",
      "minItems": 1592,
      "maxItems": 1592,
      "items": { "$ref": "#/$defs/alias" }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "collection": { "enum": ["articles", "podcasts", "books", "people"] },
    "path": { "type": "string", "pattern": "^/(?!/)[^?#\\s]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "source_path",
        "source_key",
        "checksum",
        "source_url"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_path": { "type": "string", "minLength": 1 },
        "source_key": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/sha256" },
        "source_url": { "type": "string", "pattern": "^https://github\\.com/" }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "record_key", "final_path", "source"],
      "properties": {
        "collection": { "$ref": "#/$defs/collection" },
        "record_key": { "type": "string", "minLength": 1 },
        "final_path": { "$ref": "#/$defs/path" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "record_key",
        "source_path",
        "final_path",
        "status_code",
        "query_policy"
      ],
      "properties": {
        "collection": { "$ref": "#/$defs/collection" },
        "record_key": { "type": "string", "minLength": 1 },
        "source_path": { "$ref": "#/$defs/path" },
        "final_path": { "$ref": "#/$defs/path" },
        "status_code": { "const": 301 },
        "query_policy": { "const": "preserve_raw" }
      }
    }
  }
}
