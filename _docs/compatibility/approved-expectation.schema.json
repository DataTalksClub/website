{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datatalks.club/schemas/approved-expectation-set-v1.json",
  "title": "Approved compatibility expectation set",
  "description": "Independent target approvals bound to exact legacy manifest, difference, and public-contract artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "differences_sha256",
    "expectations",
    "manifest_sha256",
    "public_contracts_sha256",
    "record_kind",
    "schema_version"
  ],
  "properties": {
    "record_kind": { "const": "approved_expectation_set" },
    "schema_version": { "const": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "differences_sha256": { "$ref": "#/$defs/sha256" },
    "public_contracts_sha256": { "$ref": "#/$defs/sha256" },
    "expectations": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/expectation" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plainString": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 8192,
      "pattern": "^https://[^\\s]+$"
    },
    "emptyOrSha256": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "stringPair": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "$ref": "#/$defs/plainString" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "urlPair": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "$ref": "#/$defs/httpsUrl" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "structuredData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "type"],
      "properties": {
        "identifier": { "$ref": "#/$defs/plainString" },
        "type": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {
          "enum": ["asset", "external_link", "form_action", "internal_link"]
        },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternates",
        "canonical_url",
        "client_redirect_url",
        "description",
        "first_heading",
        "fragments",
        "language",
        "main_content_fingerprint",
        "references",
        "robots",
        "social_metadata",
        "soft_404",
        "structured_data",
        "title"
      ],
      "properties": {
        "alternates": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/urlPair" }
        },
        "canonical_url": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/httpsUrl" }
          ]
        },
        "client_redirect_url": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/httpsUrl" }
          ]
        },
        "description": { "$ref": "#/$defs/plainString" },
        "first_heading": { "$ref": "#/$defs/plainString" },
        "fragments": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "language": { "$ref": "#/$defs/plainString" },
        "main_content_fingerprint": { "$ref": "#/$defs/emptyOrSha256" },
        "references": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "robots": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "social_metadata": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stringPair" }
        },
        "soft_404": { "type": "boolean" },
        "structured_data": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/structuredData" }
        },
        "title": { "$ref": "#/$defs/plainString" }
      }
    },
    "sitemapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastmod", "url"],
      "properties": {
        "lastmod": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))?)$"
        },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "sitemap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sitemapEntry" }
        }
      }
    },
    "expectedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_sha256",
        "content_type",
        "final_url",
        "metadata",
        "response_content_language",
        "response_last_modified",
        "response_robots",
        "sitemap",
        "status"
      ],
      "properties": {
        "body_sha256": { "$ref": "#/$defs/emptyOrSha256" },
        "content_type": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "final_url": { "$ref": "#/$defs/httpsUrl" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "response_content_language": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "response_last_modified": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "response_robots": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "sitemap": { "$ref": "#/$defs/sitemap" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "expectation_id",
        "expected_response",
        "owner",
        "public_url",
        "query_policy",
        "reason",
        "redirect_status",
        "redirect_target",
        "review_state",
        "source_scope",
        "test_reference"
      ],
      "properties": {
        "disposition": { "enum": ["preserve", "redirect", "retire"] },
        "expectation_id": {
          "type": "string",
          "pattern": "^expectation-[0-9a-f]{24}$"
        },
        "expected_response": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/expectedResponse" }
          ]
        },
        "owner": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:|[a-z0-9][a-z0-9._:-]{0,127})$"
        },
        "public_url": { "$ref": "#/$defs/httpsUrl" },
        "query_policy": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["exact", "preserve_raw"] }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "redirect_status": {
          "oneOf": [
            { "type": "null" },
            { "enum": [301, 308] }
          ]
        },
        "redirect_target": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/httpsUrl" }
          ]
        },
        "review_state": { "enum": ["approved_exception", "approved_parity"] },
        "source_scope": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "test_reference": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?:|[A-Za-z0-9_.:/\\[\\]-]+)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "preserve" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "expected_response": { "$ref": "#/$defs/expectedResponse" },
              "owner": { "const": "" },
              "query_policy": { "type": "null" },
              "reason": { "const": "" },
              "redirect_status": { "type": "null" },
              "redirect_target": { "const": "" },
              "review_state": { "const": "approved_parity" },
              "test_reference": { "const": "" }
            }
          },
          "else": {
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "review_state": { "const": "approved_exception" },
              "test_reference": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "redirect" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "expected_response": { "$ref": "#/$defs/expectedResponse" },
              "query_policy": { "enum": ["exact", "preserve_raw"] },
              "redirect_status": { "enum": [301, 308] },
              "redirect_target": { "$ref": "#/$defs/httpsUrl" }
            }
          },
          "else": {
            "if": {
              "properties": { "disposition": { "const": "retire" } },
              "required": ["disposition"]
            },
            "then": {
              "properties": {
                "expected_response": { "type": "null" },
                "query_policy": { "type": "null" },
                "redirect_status": { "type": "null" },
                "redirect_target": { "const": "" }
              }
            }
          }
        }
      ]
    }
  }
}
