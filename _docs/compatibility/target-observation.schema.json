{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datatalks.club/schemas/target-observation-set-v1.json",
  "title": "Django target compatibility observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["observations", "record_kind", "schema_version"],
  "properties": {
    "record_kind": { "const": "target_observation_set" },
    "schema_version": { "const": 1 },
    "observations": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "emptyOrSha256": {
      "oneOf": [{ "const": "" }, { "$ref": "#/$defs/sha256" }]
    },
    "url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 8192,
      "pattern": "^https?://[^\\s]+$"
    },
    "plainString": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "stringPair": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "$ref": "#/$defs/plainString" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "urlPair": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "$ref": "#/$defs/url" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "structuredData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "type"],
      "properties": {
        "identifier": { "$ref": "#/$defs/plainString" },
        "type": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {
          "enum": ["asset", "external_link", "form_action", "internal_link"]
        },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternates",
        "canonical_url",
        "client_redirect_url",
        "description",
        "first_heading",
        "fragments",
        "language",
        "main_content_fingerprint",
        "references",
        "robots",
        "social_metadata",
        "soft_404",
        "structured_data",
        "title"
      ],
      "properties": {
        "alternates": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/urlPair" }
        },
        "canonical_url": {
          "oneOf": [{ "const": "" }, { "$ref": "#/$defs/url" }]
        },
        "client_redirect_url": {
          "oneOf": [{ "const": "" }, { "$ref": "#/$defs/url" }]
        },
        "description": { "$ref": "#/$defs/plainString" },
        "first_heading": { "$ref": "#/$defs/plainString" },
        "fragments": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "language": { "$ref": "#/$defs/plainString" },
        "main_content_fingerprint": { "$ref": "#/$defs/emptyOrSha256" },
        "references": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "robots": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "social_metadata": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stringPair" }
        },
        "soft_404": { "type": "boolean" },
        "structured_data": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/structuredData" }
        },
        "title": { "$ref": "#/$defs/plainString" }
      }
    },
    "sitemapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastmod", "url"],
      "properties": {
        "lastmod": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))?)$"
        },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "sitemap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sitemapEntry" }
        }
      }
    },
    "redirectHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "url"],
      "properties": {
        "status": { "enum": [301, 302, 303, 307, 308] },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_sha256",
        "capture_error",
        "content_type",
        "elapsed_ms",
        "final_url",
        "metadata",
        "raw_network_reference",
        "redirect_chain",
        "requested_url",
        "response_content_language",
        "response_count",
        "response_last_modified",
        "response_location",
        "response_robots",
        "schema_version",
        "sitemap",
        "status",
        "transfer_bytes"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "requested_url": { "$ref": "#/$defs/url" },
        "raw_network_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^/[^\\u0000-\\u001f#\\s]*$"
        },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "final_url": { "$ref": "#/$defs/url" },
        "response_count": { "type": "integer", "minimum": 1 },
        "transfer_bytes": { "type": "integer", "minimum": 0 },
        "content_type": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "response_last_modified": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "response_content_language": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "response_robots": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "response_location": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "body_sha256": { "$ref": "#/$defs/emptyOrSha256" },
        "redirect_chain": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/redirectHop" }
        },
        "metadata": { "$ref": "#/$defs/metadata" },
        "sitemap": { "$ref": "#/$defs/sitemap" },
        "capture_error": {
          "type": "string",
          "pattern": "^(?:|[a-z][a-z0-9_]{0,127})$"
        },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
