.git
.github
.tmp
.venv
.aplexer-tasks
# Verification, authoring and release-control material is not part of the
# runtime image. Django source and migrations remain in the build context.
**/tests
tests_ci
ci
playwright_tests
test_support
_docs
.agents
# Release tooling includes account ids, role ARNs, and inactive ECS commands.
# Keep only the two safe value modules still imported by the Django runtime.
deploy
!deploy/
!deploy/__init__.py
!deploy/release_identity.py
!deploy/development_target.py
# Recursive, not root-only.  A bare `.env` excludes only the one at the root,
# so `e2e/.env` — which e2e/.env.example tells developers to create, holding an
# API token and an admin password — was copied into the image by the Dockerfile's
# whole-context COPY.  The same applies to a database file in any subdirectory.
**/.env
**/*.sqlite3
**/*.sqlite3-*
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
playwright-report
test-results
_docs/planning
# The release image serves projection media from the object store, never from the
# build context. Excluding a locally hydrated tree keeps a local image build byte
# equivalent to a CI build from a clean checkout.
.local-media
# The migration snapshot under temporary/content/ is an explicit prod-ingest
# helper only. It is never read by default runtime and must not ship in the
# release image: Docker builds from a clean checkout must produce an empty
# public catalogue until the migration owner runs scripts/prod/* explicitly.
temporary/
