# Copy to .env for local development. Values below are placeholders only.
DTC_ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=website.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web.dtcdev.click
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://web.dtcdev.click
DATABASE_URL=postgresql://dtc:replace-me@127.0.0.1:5432/dtc_website
DTC_USE_SQLITE=0
DTC_SQLITE_PATH=db.sqlite3
APP_VERSION=dev
