# Copy to .env for local development. Values below are placeholders only.
DTC_ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=website.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web.dtcdev.click
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://web.dtcdev.click
# Optional. Relative paths resolve from the repository root.
DTC_SQLITE_PATH=.tmp/local.sqlite3
# Optional. Set this to the GitHub webhook secret for registered course repositories.
COURSE_REPOSITORY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Optional. The source-managed homework answer keyring is injected separately.
# COURSE_HOMEWORK_ANSWER_KEYRING=
# Optional. Public projection images are read through a pluggable media store.
# `local` (default) reads the gitignored content/public_projection/media tree that
# `manage.py public_media_hydrate` materialises. `memory` is the deterministic offline
# fixture used by CI. A deployed environment uses `s3` plus a bucket name.
# PUBLIC_MEDIA_STORE_BACKEND=local
# PUBLIC_MEDIA_S3_BUCKET=
# PUBLIC_MEDIA_S3_REGION=
# Optional. The private, in-VPC address of Relay. Relay renders every open,
# click and unsubscribe link in mail from its own PUBLIC_BASE_URL, which points
# at this site, so this site answers those paths and hands each one to Relay.
# Relay has no public listener, so this is never a public URL. Leave it unset
# locally: with no Relay configured the three routes answer 404 and the click
# route never redirects.
# RELAY_LINK_BRIDGE_BASE_URL=http://relay.website.internal:8000
