# Copy to .env for local development. Values below are placeholders only.
DTC_ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=website.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dev.datatalks.club
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://dev.datatalks.club
# Optional. Relative paths resolve from the repository root.
DTC_SQLITE_PATH=.tmp/local.sqlite3
# Optional. Set this to the GitHub webhook secret for registered course repositories.
COURSE_REPOSITORY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Optional. The source-managed homework answer keyring is injected separately.
# COURSE_HOMEWORK_ANSWER_KEYRING=
# Optional. Public projection images are read through a pluggable media store.
# `local` (default) reads the gitignored content/public_projection/media tree that
# scripts/prod/sync_public_media_hydrate.py materialises -- needs no AWS credential,
# works offline. `memory` is the deterministic offline fixture used by CI. `s3` reads the
# real published bucket directly and needs no hydration, but needs AWS credentials
# in your ambient environment (env vars, profile, or SSO) that can read
# s3://dtc-website-media/images/*. Uncomment to opt in once you have that access;
# see _docs/runbooks/public-media-objects.md for what credentials are required.
# PUBLIC_MEDIA_STORE_BACKEND=s3
# PUBLIC_MEDIA_S3_BUCKET=dtc-website-media
# PUBLIC_MEDIA_S3_REGION=eu-west-1
# Optional. Extra operator recipients for application-style registration
# notices, comma-separated. Every new pending registration on a campaign with
# requires_approval emails these addresses plus alexey@datatalks.club
# (always retained) via the application-pending-operator mail purpose.
# APPLICATION_NOTIFICATION_OPERATORS=ops@example.com,review@example.com
# Optional. Telegram chat for loud operational failure notices that must never
# break the user request (e.g. registration contact-sync failures). Without
# both values the failure is still error-logged, but no Telegram notice goes
# out and the failed notice itself is logged.
# OPERATOR_ALERT_TELEGRAM_BOT_TOKEN=123456:replace-with-telegram-bot-token
# OPERATOR_ALERT_TELEGRAM_CHAT_ID=-123456789
# Optional. The private, in-VPC address of Relay. Relay renders every open,
# click and unsubscribe link in mail from its own PUBLIC_BASE_URL, which points
# at this site, so this site answers those paths and hands each one to Relay.
# Relay has no public listener, so this is never a public URL. Leave it unset
# locally: with no Relay configured the three routes answer 404 and the click
# route never redirects.
# RELAY_LINK_BRIDGE_BASE_URL=http://relay.website.internal:8000
