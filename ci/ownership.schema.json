{
  "$id": "https://datatalks.club/schemas/ci/ownership-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {"type": "object", "minProperties": 1},
    "large_content": {"type": "object"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["components", "downstream", "environment_dimensions", "exact", "id", "kind", "prefixes", "render_flags", "risk_flags", "validity_class"],
        "properties": {
          "components": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "downstream": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "environment_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "exact": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["owner", "verification"]},
          "prefixes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "render_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "risk_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "test_labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "validity_class": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy_version": {"const": 5},
    "render_rules": {"type": "object"},
    "risk_rules": {
      "additionalProperties": false,
      "properties": {
        "configuration_hidden_prefixes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "configuration_prefixes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "configuration_suffixes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "global_fixture_segments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "migration_segments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "policy_doc_exact": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "policy_doc_prefixes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "test_basenames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "test_segments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "required": ["configuration_hidden_prefixes", "configuration_prefixes", "configuration_suffixes", "global_fixture_segments", "migration_segments", "policy_doc_exact", "policy_doc_prefixes", "test_basenames", "test_segments"],
      "type": "object"
    },
    "schema_version": {"const": 2},
    "screenshot_contract": {
      "additionalProperties": false,
      "properties": {
        "routes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "nodes": {
                "items": {"minLength": 1, "type": "string"},
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "route": {"pattern": "^/", "type": "string"},
              "state": {"minLength": 1, "type": "string"}
            },
            "required": ["nodes", "route", "state"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "viewports": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "height": {"minimum": 1, "type": "integer"},
              "name": {"enum": ["desktop", "mobile"]},
              "width": {"minimum": 1, "type": "integer"}
            },
            "required": ["height", "name", "width"],
            "type": "object"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["routes", "viewports"],
      "type": "object"
    },
    "validity_classes": {"type": "object", "minProperties": 1}
  },
  "required": ["components", "large_content", "nodes", "policy_version", "render_rules", "risk_rules", "schema_version", "screenshot_contract", "validity_classes"],
  "title": "DataTalksClub verification ownership graph v2",
  "type": "object"
}
