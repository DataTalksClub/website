  "large_content": {
    "identity_fields": ["id", "key", "path", "slug", "source_path", "record_key"],
    "metadata_fields": ["description", "heading_id", "name", "title", "record_key"],
    "patterns": ["content/**", "courses/**", "data/**", "_docs/compatibility/**"],
    "structured_extensions": [".csv", ".json", ".jsonl", ".yaml", ".yml"],
    "url_fields": ["href", "path", "url", "public_path", "final_path"]
  },
  "policy_version": 5,
  "render_rules": {
    "basenames": ["context_processors.py", "serializers.py", "urls.py", "views.py"],
    "extensions": [".css", ".htm", ".html", ".jinja", ".jinja2", ".js", ".mjs", ".tmpl", ".tpl"],
    "segments": ["static", "templates"]
  },
  "risk_rules": {
    "configuration_hidden_prefixes": ["."],
    "configuration_prefixes": ["requirements"],
    "configuration_suffixes": [".lock", ".toml", ".yaml", ".yml"],
    "global_fixture_segments": ["fixtures"],
    "migration_segments": ["migrations"],
    "policy_doc_prefixes": ["_docs/ci/"],
    "policy_doc_exact": ["_docs/PROCESS.md"],
    "test_basenames": ["conftest.py"],
    "test_segments": ["tests", "tests_ci", "playwright_tests", "e2e"]
  },
  "schema_version": 2,
  "screenshot_contract": {
    "routes": [
      {
        "nodes": ["app.content", "shared.core", "surface.playwright", "surface.templates", "surface.website"],
        "route": "/",
        "state": "home"
      },
      {
        "nodes": ["app.api", "app.courses", "app.data", "app.studio_courses", "shared.core", "surface.course_platform_templates", "surface.playwright", "surface.templates"],
        "route": "/courses",
        "state": "courses"
      },
      {
        "nodes": ["app.studio", "shared.accounts", "shared.core", "surface.playwright", "surface.templates"],
        "route": "/studio/",
        "state": "studio-sign-in"
      },
      {
        "nodes": ["shared.core", "surface.playwright", "surface.templates", "surface.website"],
        "route": "/__verification_missing__",
        "state": "not-found"
      }
    ],
    "viewports": [
      {"height": 900, "name": "desktop", "width": 1440},
      {"height": 844, "name": "mobile", "width": 390}
    ]
  },
  "validity_classes": {
    "live": 14400,
    "standard": 604800,
    "visual": 604800,
    "volatile": 86400
  }
